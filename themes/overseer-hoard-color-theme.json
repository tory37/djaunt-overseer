        "fontStyle": "italic"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E7874A"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#D3E3DD",
