{
  "name": "djaunt-overseer",
  "displayName": "Overseer",
  "description": "Vertical tabs for Claude CLI sessions: group by ticket, suspend, and resume from any repo.",
  "version": "0.0.1",
  "publisher": "djaunt",
  "private": true,
  "license": "UNLICENSED",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "djauntOverseer",
          "title": "Overseer",
          "icon": "media/overseer.svg"
        }
      ]
    },
    "views": {
      "djauntOverseer": [
        {
          "id": "overseer.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "overseer.sessions",
        "contents": "No pinned sessions yet.\n[Browse all sessions](command:overseer.allSessions)"
      }
    ],
    "commands": [
      {
        "command": "overseer.allSessions",
        "title": "All Sessions\u2026",
        "category": "Overseer",
        "icon": "$(search)"
      },
      {
        "command": "overseer.refreshIndex",
        "title": "Refresh Session Index",
        "category": "Overseer",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "overseer.allSessions",
          "when": "view == overseer.sessions",
          "group": "navigation@1"
        },
        {
          "command": "overseer.refreshIndex",
          "when": "view == overseer.sessions",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "Overseer",
      "properties": {
        "overseer.claudeHome": {
          "type": "string",
          "default": "",
          "description": "Claude config directory. Empty means ~/.claude."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
