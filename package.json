{
  "name": "djaunt-overseer",
  "displayName": "Overseer",
  "description": "Vertical tabs for Claude CLI sessions: group by ticket, suspend, and resume from any repo.",
  "version": "0.0.9",
  "publisher": "djaunt",
  "private": true,
  "license": "UNLICENSED",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/tory37/djaunt-overseer"
  },
  "homepage": "https://tory37.github.io/djaunt-overseer/",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "djauntOverseer",
          "title": "Overseer",
          "icon": "media/overseer.svg"
        }
      ]
    },
    "views": {
      "djauntOverseer": [
        {
          "id": "overseer.sessions",
          "name": "Sessions",
          "when": "config.overseer.views.sessions"
        },
        {
          "id": "overseer.terminals",
          "name": "Terminals",
          "when": "config.overseer.views.terminals"
        },
        {
          "id": "overseer.repos",
          "name": "Repos",
          "when": "config.overseer.views.repos"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "overseer.sessions",
        "contents": "No pinned sessions yet.\n[Browse all sessions](command:overseer.allSessions)"
      },
      {
        "view": "overseer.terminals",
        "contents": "No terminals yet.\n[New Terminal](command:overseer.newTerminal)"
      },
      {
        "view": "overseer.repos",
        "contents": "No repos yet. Pin a session or open a terminal in a git repo."
      }
    ],
    "commands": [
      {
        "command": "overseer.allSessions",
        "title": "All Sessions…",
        "category": "Overseer",
        "icon": "$(search)"
      },
      {
        "command": "overseer.refreshIndex",
        "title": "Refresh Session Index",
        "category": "Overseer",
        "icon": "$(refresh)"
      },
      {
        "command": "overseer.newGroup",
        "title": "New Group…",
        "category": "Overseer",
        "icon": "$(new-folder)"
      },
      {
        "command": "overseer.resumeSession",
        "title": "Resume",
        "category": "Overseer",
        "icon": "$(play)"
      },
      {
        "command": "overseer.focusSession",
        "title": "Focus Session",
        "category": "Overseer"
      },
      {
        "command": "overseer.addExistingToGroup",
        "title": "Add Existing Session…",
        "category": "Overseer",
        "icon": "$(search)"
      },
      {
        "command": "overseer.killSession",
        "title": "Kill and Remove",
        "category": "Overseer",
        "icon": "$(trash)"
      },
      {
        "command": "overseer.unpinSession",
        "title": "Remove from Sidebar",
        "category": "Overseer",
        "icon": "$(close)"
      },
      {
        "command": "overseer.renameGroup",
        "title": "Rename Group…",
        "category": "Overseer"
      },
      {
        "command": "overseer.deleteGroup",
        "title": "Delete Group",
        "category": "Overseer"
      },
      {
        "command": "overseer.rename",
        "title": "Rename",
        "category": "Overseer"
      },
      {
        "command": "overseer.newSession",
        "title": "New Session…",
        "category": "Overseer",
        "icon": "$(add)"
      },
      {
        "command": "overseer.newTerminal",
        "title": "New Terminal…",
        "category": "Overseer",
        "icon": "$(terminal)"
      },
      {
        "command": "overseer.openTerminal",
        "title": "Open Terminal",
        "category": "Overseer",
        "icon": "$(play)"
      },
      {
        "command": "overseer.renameTerminal",
        "title": "Rename Terminal",
        "category": "Overseer"
      },
      {
        "command": "overseer.suspendSession",
        "title": "Suspend",
        "category": "Overseer",
        "icon": "$(debug-pause)"
      },
      {
        "command": "overseer.suspendGroup",
        "title": "Suspend All in Group",
        "category": "Overseer",
        "icon": "$(debug-pause)"
      },
      {
        "command": "overseer.renameSession",
        "title": "Rename Session…",
        "category": "Overseer"
      },
      {
        "command": "overseer.clickSession",
        "title": "Open Session",
        "category": "Overseer"
      },
      {
        "command": "overseer.compactSession",
        "title": "Compact",
        "category": "Overseer"
      },
      {
        "command": "overseer.switchModel",
        "title": "Switch Model…",
        "category": "Overseer"
      },
      {
        "command": "overseer.clearSession",
        "title": "Clear Context",
        "category": "Overseer"
      },
      {
        "command": "overseer.costSession",
        "title": "Show Cost",
        "category": "Overseer"
      },
      {
        "command": "overseer.findResources",
        "title": "Find Resources",
        "category": "Overseer",
        "icon": "$(search)"
      },
      {
        "command": "overseer.summarizeSession",
        "title": "Summarize with Haiku",
        "category": "Overseer",
        "icon": "$(sparkle)"
      },
      {
        "command": "overseer.openRepoInScm",
        "title": "Open Repo in Source Control",
        "category": "Overseer",
        "icon": "$(source-control)"
      },
      {
        "command": "overseer.refreshRepos",
        "title": "Refresh Repos",
        "category": "Overseer",
        "icon": "$(refresh)"
      },
      {
        "command": "overseer.openRepoInNewWindow",
        "title": "Open Repo in New Window",
        "category": "Overseer",
        "icon": "$(empty-window)"
      },
      {
        "command": "overseer.copyRepoPath",
        "title": "Copy Repo Path",
        "category": "Overseer"
      },
      {
        "command": "overseer.showCommit",
        "title": "Show Commit",
        "category": "Overseer"
      },
      {
        "command": "overseer.copyCommitHash",
        "title": "Copy Commit Hash",
        "category": "Overseer"
      },
      {
        "command": "overseer.revealCommitSession",
        "title": "Show Session",
        "category": "Overseer"
      },
      {
        "command": "overseer.openCommitOnGitHub",
        "title": "Open Commit on GitHub",
        "category": "Overseer",
        "icon": "$(github)"
      },
      {
        "command": "overseer.toggleRemovedLinks",
        "title": "Toggle Removed Links",
        "category": "Overseer"
      },
      {
        "command": "overseer.moveTicketStatus",
        "title": "Move to Status…",
        "category": "Overseer",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "overseer.refreshJiraProjects",
        "title": "Refresh Jira Statuses",
        "category": "Overseer"
      },
      {
        "command": "overseer.openSettings",
        "title": "Settings…",
        "category": "Overseer",
        "icon": "$(gear)"
      },
      {
        "command": "overseer.setSessionStatus",
        "title": "Set Status…",
        "category": "Overseer",
        "icon": "$(tag)"
      },
      {
        "command": "overseer.openStatusSettings",
        "title": "Session Status Settings…",
        "category": "Overseer"
      },
      {
        "command": "overseer.openSessionSettings",
        "title": "Session Icon Settings…",
        "category": "Overseer"
      },
      {
        "command": "overseer.openJiraSettings",
        "title": "Jira Settings…",
        "category": "Overseer"
      },
      {
        "command": "overseer.openGithubSettings",
        "title": "GitHub Settings…",
        "category": "Overseer"
      },
      {
        "command": "overseer.openAllSettings",
        "title": "All Settings (Settings Editor)",
        "category": "Overseer"
      },
      {
        "command": "overseer.enableJira",
        "title": "Enable Jira Integration",
        "category": "Overseer"
      },
      {
        "command": "overseer.disableJira",
        "title": "Disable Jira Integration",
        "category": "Overseer"
      },
      {
        "command": "overseer.enableGithub",
        "title": "Enable GitHub Integration",
        "category": "Overseer"
      },
      {
        "command": "overseer.disableGithub",
        "title": "Disable GitHub Integration",
        "category": "Overseer"
      },
      {
        "command": "overseer.enableArtifacts",
        "title": "Enable Artifact Links",
        "category": "Overseer"
      },
      {
        "command": "overseer.disableArtifacts",
        "title": "Disable Artifact Links",
        "category": "Overseer"
      },
      {
        "command": "overseer.openResources",
        "title": "Open Links",
        "category": "Overseer"
      },
      {
        "command": "overseer.installCompactHooks",
        "title": "Install Compact Hooks",
        "category": "Overseer"
      },
      {
        "command": "overseer.removeCompactHooks",
        "title": "Remove Compact Hooks",
        "category": "Overseer"
      },
      {
        "command": "overseer.runSessionCommand",
        "title": "Commands…",
        "category": "Overseer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "overseer.newSession",
          "when": "view == overseer.sessions",
          "group": "navigation@0"
        },
        {
          "command": "overseer.newTerminal",
          "when": "view == overseer.terminals",
          "group": "navigation@0"
        },
        {
          "command": "overseer.allSessions",
          "when": "view == overseer.sessions",
          "group": "navigation@1"
        },
        {
          "command": "overseer.newGroup",
          "when": "view == overseer.sessions",
          "group": "navigation@2"
        },
        {
          "command": "overseer.refreshIndex",
          "when": "view == overseer.sessions",
          "group": "navigation@9"
        },
        {
          "command": "overseer.openSettings",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/",
          "group": "9_settings@1"
        },
        {
          "command": "overseer.refreshRepos",
          "when": "view == overseer.repos",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "overseer.setSessionStatus",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^(session|terminal)\\./",
          "group": "1_session@4"
        },
        {
          "command": "overseer.resumeSession",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^session\\.(suspended|elsewhere)$/",
          "group": "inline@1"
        },
        {
          "command": "overseer.resumeSession",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^session\\.(suspended|elsewhere)$/",
          "group": "1_session@1"
        },
        {
          "command": "overseer.unpinSession",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^session\\./",
          "group": "9_remove@1"
        },
        {
          "command": "overseer.killSession",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^session\\./",
          "group": "9_remove@2"
        },
        {
          "command": "overseer.renameGroup",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^group\\.(user|auto)$/",
          "group": "1_group@1"
        },
        {
          "command": "overseer.deleteGroup",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem == group.user",
          "group": "9_remove@1"
        },
        {
          "command": "overseer.suspendSession",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^session\\.(running|working)$/",
          "group": "inline@1"
        },
        {
          "command": "overseer.suspendSession",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^session\\.(running|working)$/",
          "group": "1_session@2"
        },
        {
          "command": "overseer.renameSession",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^session\\./",
          "group": "1_session@3"
        },
        {
          "command": "overseer.newSession",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "inline@0"
        },
        {
          "command": "overseer.addExistingToGroup",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "inline@1"
        },
        {
          "command": "overseer.addExistingToGroup",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "1_group@0"
        },
        {
          "command": "overseer.newSession",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "1_group@0"
        },
        {
          "command": "overseer.suspendGroup",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "1_group@2"
        },
        {
          "command": "overseer.compactSession",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem == session.running",
          "group": "2_claude@1"
        },
        {
          "command": "overseer.switchModel",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem == session.running",
          "group": "2_claude@2"
        },
        {
          "command": "overseer.clearSession",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem == session.running",
          "group": "2_claude@3"
        },
        {
          "command": "overseer.costSession",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem == session.running",
          "group": "2_claude@4"
        },
        {
          "command": "overseer.findResources",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^session\\./",
          "group": "3_links@1"
        },
        {
          "command": "overseer.summarizeSession",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^session\\./",
          "group": "3_links@2"
        },
        {
          "command": "overseer.openRepoInScm",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^(session|terminal)\\./",
          "group": "4_repo@1"
        },
        {
          "command": "overseer.openTerminal",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem == terminal.closed",
          "group": "inline@1"
        },
        {
          "command": "overseer.openTerminal",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem == terminal.closed",
          "group": "1_session@1"
        },
        {
          "command": "overseer.renameTerminal",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^terminal\\./",
          "group": "1_session@3"
        },
        {
          "command": "overseer.unpinSession",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^terminal\\./",
          "group": "9_remove@1"
        },
        {
          "command": "overseer.killSession",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem =~ /^terminal\\./",
          "group": "9_remove@2"
        },
        {
          "command": "overseer.newTerminal",
          "when": "view == overseer.terminals && viewItem =~ /^group\\./",
          "group": "inline@0"
        },
        {
          "command": "overseer.newTerminal",
          "when": "view == overseer.terminals && viewItem =~ /^group\\./",
          "group": "1_group@1"
        },
        {
          "command": "overseer.openRepoInScm",
          "when": "view == overseer.repos && viewItem == repo",
          "group": "inline@1"
        },
        {
          "command": "overseer.openRepoInScm",
          "when": "view == overseer.repos && viewItem == repo",
          "group": "1_open@1"
        },
        {
          "command": "overseer.openRepoInNewWindow",
          "when": "view == overseer.repos && viewItem == repo",
          "group": "1_open@2"
        },
        {
          "command": "overseer.copyRepoPath",
          "when": "view == overseer.repos && viewItem == repo",
          "group": "2_copy@1"
        },
        {
          "command": "overseer.revealCommitSession",
          "when": "view == overseer.repos && viewItem == commit.session",
          "group": "1_open@1"
        },
        {
          "command": "overseer.openCommitOnGitHub",
          "when": "view == overseer.repos && viewItem =~ /^commit/",
          "group": "1_open@2"
        },
        {
          "command": "overseer.copyCommitHash",
          "when": "view == overseer.repos && viewItem =~ /^commit/",
          "group": "2_copy@1"
        },
        {
          "command": "overseer.runSessionCommand",
          "when": "view =~ /^overseer\\.(sessions|terminals)$/ && viewItem == session.running",
          "group": "2_claude@5"
        }
      ],
      "commandPalette": [
        {
          "command": "overseer.resumeSession",
          "when": "false"
        },
        {
          "command": "overseer.focusSession",
          "when": "false"
        },
        {
          "command": "overseer.unpinSession",
          "when": "false"
        },
        {
          "command": "overseer.killSession",
          "when": "false"
        },
        {
          "command": "overseer.addExistingToGroup",
          "when": "false"
        },
        {
          "command": "overseer.renameGroup",
          "when": "false"
        },
        {
          "command": "overseer.deleteGroup",
          "when": "false"
        },
        {
          "command": "overseer.rename",
          "when": "false"
        },
        {
          "command": "overseer.suspendSession",
          "when": "false"
        },
        {
          "command": "overseer.suspendGroup",
          "when": "false"
        },
        {
          "command": "overseer.renameSession",
          "when": "false"
        },
        {
          "command": "overseer.clickSession",
          "when": "false"
        },
        {
          "command": "overseer.compactSession",
          "when": "false"
        },
        {
          "command": "overseer.switchModel",
          "when": "false"
        },
        {
          "command": "overseer.clearSession",
          "when": "false"
        },
        {
          "command": "overseer.costSession",
          "when": "false"
        },
        {
          "command": "overseer.findResources",
          "when": "false"
        },
        {
          "command": "overseer.summarizeSession",
          "when": "false"
        },
        {
          "command": "overseer.moveTicketStatus",
          "when": "false"
        },
        {
          "command": "overseer.enableJira",
          "when": "!config.overseer.links.jira.enabled"
        },
        {
          "command": "overseer.disableJira",
          "when": "config.overseer.links.jira.enabled"
        },
        {
          "command": "overseer.enableGithub",
          "when": "!config.overseer.links.github.enabled"
        },
        {
          "command": "overseer.disableGithub",
          "when": "config.overseer.links.github.enabled"
        },
        {
          "command": "overseer.enableArtifacts",
          "when": "!config.overseer.links.artifacts.enabled"
        },
        {
          "command": "overseer.disableArtifacts",
          "when": "config.overseer.links.artifacts.enabled"
        },
        {
          "command": "overseer.openResources",
          "when": "false"
        },
        {
          "command": "overseer.openTerminal",
          "when": "false"
        },
        {
          "command": "overseer.renameTerminal",
          "when": "false"
        },
        {
          "command": "overseer.openRepoInNewWindow",
          "when": "false"
        },
        {
          "command": "overseer.copyRepoPath",
          "when": "false"
        },
        {
          "command": "overseer.showCommit",
          "when": "false"
        },
        {
          "command": "overseer.copyCommitHash",
          "when": "false"
        },
        {
          "command": "overseer.revealCommitSession",
          "when": "false"
        },
        {
          "command": "overseer.openCommitOnGitHub",
          "when": "false"
        },
        {
          "command": "overseer.runSessionCommand",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Overseer",
      "properties": {
        "overseer.views.sessions": {
          "type": "boolean",
          "default": true,
          "description": "Show the Sessions view."
        },
        "overseer.views.terminals": {
          "type": "boolean",
          "default": true,
          "description": "Show the Terminals view."
        },
        "overseer.views.repos": {
          "type": "boolean",
          "default": true,
          "description": "Show the Repos view."
        },
        "overseer.sessionStatuses": {
          "type": "array",
          "default": [
            {
              "id": "todo",
              "name": "Todo",
              "color": "gray",
              "icon": "circle-large-outline",
              "badge": "TD",
              "asksReason": false
            },
            {
              "id": "triage",
              "name": "Triage",
              "color": "orange",
              "icon": "search",
              "badge": "TR",
              "asksReason": false
            },
            {
              "id": "in-progress",
              "name": "In Progress",
              "color": "blue",
              "icon": "play-circle",
              "badge": "IP",
              "asksReason": false
            },
            {
              "id": "blocked",
              "name": "Blocked",
              "color": "red",
              "icon": "circle-slash",
              "badge": "BL",
              "asksReason": true
            },
            {
              "id": "ai-review",
              "name": "AI Review",
              "color": "purple",
              "icon": "sparkle",
              "badge": "AI",
              "asksReason": false
            },
            {
              "id": "human-review",
              "name": "Human Review",
              "color": "yellow",
              "icon": "eye",
              "badge": "HR",
              "asksReason": false
            },
            {
              "id": "ready-to-ship",
              "name": "Ready to Ship",
              "color": "green",
              "icon": "rocket",
              "badge": "RS",
              "asksReason": false
            }
          ],
          "markdownDescription": "Statuses you can set on a session or terminal with **Set Status…**. A status tints the row's label and adds its badge. Edit them in **Overseer: Session Status Settings…**.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable id. Sessions keep their status by this id when the name changes."
              },
              "name": {
                "type": "string"
              },
              "color": {
                "type": "string",
                "enum": [
                  "gray",
                  "red",
                  "orange",
                  "yellow",
                  "green",
                  "teal",
                  "blue",
                  "purple",
                  "pink"
                ],
                "default": "gray"
              },
              "icon": {
                "type": "string",
                "description": "Codicon name, shown in the status picker and the row's tooltip."
              },
              "badge": {
                "type": "string",
                "maxLength": 2,
                "description": "Up to two characters on the right of the row. Empty shows no badge."
              },
              "asksReason": {
                "type": "boolean",
                "default": false,
                "description": "Ask for a reason when this status is set. The reason shows in the row's tooltip."
              }
            }
          }
        },
        "overseer.claudeHome": {
          "type": "string",
          "default": "",
          "description": "Claude config directory. Empty means ~/.claude."
        },
        "overseer.links.github.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show GitHub pull requests under each session."
        },
        "overseer.links.jira.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Jira tickets under each session."
        },
        "overseer.links.artifacts.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show claude.ai artifacts under each session."
        },
        "overseer.links.jira.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Jira site for tickets whose URL the transcript doesn't show, e.g. https://acme.atlassian.net."
        },
        "overseer.jira.mcpServer": {
          "type": "string",
          "default": "jira",
          "description": "Name of the stdio Jira MCP server in ~/.claude.json. Overseer starts it to read ticket status and move tickets."
        },
        "overseer.links.judgeModel": {
          "type": "string",
          "default": "haiku",
          "description": "Model that decides which links matter to a session. Runs headless through the claude CLI."
        },
        "overseer.links.showIrrelevant": {
          "type": "boolean",
          "default": false,
          "description": "Also show links the judge marked irrelevant, dimmed."
        },
        "overseer.links.showRemoved": {
          "type": "boolean",
          "default": false,
          "description": "Also show links you removed, dimmed, so you can restore them."
        },
        "overseer.links.liveStatus": {
          "type": "boolean",
          "default": true,
          "description": "Show live PR state through gh and Jira status through your Jira MCP server. Checked every five minutes for expanded sessions."
        },
        "overseer.summary.model": {
          "type": "string",
          "default": "haiku",
          "description": "Model for Summarize with Haiku. Runs only when you click it."
        },
        "overseer.sessionIcons.working": {
          "type": "string",
          "default": "loading~spin",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(~spin)?$",
          "markdownDescription": "[Codicon](https://microsoft.github.io/vscode-codicons/dist/codicon.html) for a session that is working in this window. Set its color with `overseer.sessionWorking` in `workbench.colorCustomizations`, or in **Overseer: Session Icon Settings…**."
        },
        "overseer.sessionIcons.compacting": {
          "type": "string",
          "default": "sync~spin",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(~spin)?$",
          "markdownDescription": "[Codicon](https://microsoft.github.io/vscode-codicons/dist/codicon.html) for a session that is compacting. Needs **Overseer: Install Compact Hooks**. Set its color with `overseer.sessionCompacting` in `workbench.colorCustomizations`, or in **Overseer: Session Icon Settings…**."
        },
        "overseer.sessionIcons.running": {
          "type": "string",
          "default": "terminal",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(~spin)?$",
          "markdownDescription": "[Codicon](https://microsoft.github.io/vscode-codicons/dist/codicon.html) for a session that is running in this window. Set its color with `overseer.sessionRunning` in `workbench.colorCustomizations`, or in **Overseer: Session Icon Settings…**."
        },
        "overseer.sessionIcons.elsewhere": {
          "type": "string",
          "default": "window",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(~spin)?$",
          "markdownDescription": "[Codicon](https://microsoft.github.io/vscode-codicons/dist/codicon.html) for a session that is running outside this window. Set its color with `overseer.sessionElsewhere` in `workbench.colorCustomizations`, or in **Overseer: Session Icon Settings…**."
        },
        "overseer.sessionIcons.suspended": {
          "type": "string",
          "default": "debug-pause",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(~spin)?$",
          "markdownDescription": "[Codicon](https://microsoft.github.io/vscode-codicons/dist/codicon.html) for a session that is suspended. Set its color with `overseer.sessionSuspended` in `workbench.colorCustomizations`, or in **Overseer: Session Icon Settings…**."
        },
        "overseer.sessionIcons.duplicate": {
          "type": "string",
          "default": "warning",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(~spin)?$",
          "markdownDescription": "[Codicon](https://microsoft.github.io/vscode-codicons/dist/codicon.html) for a session that is more than one copy running. Set its color with `overseer.sessionDuplicate` in `workbench.colorCustomizations`, or in **Overseer: Session Icon Settings…**."
        },
        "overseer.sessionCommands": {
          "type": "array",
          "default": [
            {
              "name": "Check PR Reviews",
              "prompt": "Latest reviews are in on the PR. Pull them and evaluate."
            },
            {
              "name": "Monitor AI Code Reviews",
              "prompt": "Start monitoring for new AI code reviews, address them as they land."
            },
            {
              "name": "Triage",
              "prompt": "Start triage for: {ticket link}"
            }
          ],
          "markdownDescription": "Prompts you can send to an idle session with **Commands…** (right-click a session). Write `{name}` in a prompt to be asked for that value first, like `Start triage for: {ticket link}`.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Shown in the picker."
              },
              "prompt": {
                "type": "string",
                "description": "Sent to the session. Use {name} for a value to ask for."
              }
            },
            "required": [
              "name",
              "prompt"
            ]
          }
        }
      }
    },
    "keybindings": [
      {
        "command": "overseer.rename",
        "key": "f2",
        "when": "focusedView =~ /^overseer\\.(sessions|terminals)$/"
      }
    ],
