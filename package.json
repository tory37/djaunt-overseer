{
  "name": "djaunt-overseer",
  "displayName": "Overseer",
  "description": "Vertical tabs for Claude CLI sessions: group by ticket, suspend, and resume from any repo.",
  "version": "0.0.3",
  "publisher": "djaunt",
  "private": true,
  "license": "UNLICENSED",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/tory37/djaunt-overseer"
  },
  "homepage": "https://tory37.github.io/djaunt-overseer/",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "djauntOverseer",
          "title": "Overseer",
          "icon": "media/overseer.svg"
        }
      ]
    },
    "views": {
      "djauntOverseer": [
        {
          "id": "overseer.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "overseer.sessions",
        "contents": "No pinned sessions yet.\n[Browse all sessions](command:overseer.allSessions)"
      }
    ],
    "commands": [
      {
        "command": "overseer.allSessions",
        "title": "All Sessions…",
        "category": "Overseer",
        "icon": "$(search)"
      },
      {
        "command": "overseer.refreshIndex",
        "title": "Refresh Session Index",
        "category": "Overseer",
        "icon": "$(refresh)"
      },
      {
        "command": "overseer.newGroup",
        "title": "New Group…",
        "category": "Overseer",
        "icon": "$(new-folder)"
      },
      {
        "command": "overseer.resumeSession",
        "title": "Resume",
        "category": "Overseer",
        "icon": "$(play)"
      },
      {
        "command": "overseer.focusSession",
        "title": "Focus Session",
        "category": "Overseer"
      },
      {
        "command": "overseer.addExistingToGroup",
        "title": "Add Existing Session…",
        "category": "Overseer",
        "icon": "$(search)"
      },
      {
        "command": "overseer.killSession",
        "title": "Kill and Remove",
        "category": "Overseer",
        "icon": "$(trash)"
      },
      {
        "command": "overseer.unpinSession",
        "title": "Remove from Sidebar",
        "category": "Overseer",
        "icon": "$(close)"
      },
      {
        "command": "overseer.renameGroup",
        "title": "Rename Group…",
        "category": "Overseer"
      },
      {
        "command": "overseer.deleteGroup",
        "title": "Delete Group",
        "category": "Overseer"
      },
      {
        "command": "overseer.rename",
        "title": "Rename",
        "category": "Overseer"
      },
      {
        "command": "overseer.newSession",
        "title": "New Session…",
        "category": "Overseer",
        "icon": "$(add)"
      },
      {
        "command": "overseer.suspendSession",
        "title": "Suspend",
        "category": "Overseer",
        "icon": "$(debug-pause)"
      },
      {
        "command": "overseer.suspendGroup",
        "title": "Suspend All in Group",
        "category": "Overseer",
        "icon": "$(debug-pause)"
      },
      {
        "command": "overseer.renameSession",
        "title": "Rename Session…",
        "category": "Overseer"
      },
      {
        "command": "overseer.clickSession",
        "title": "Open Session",
        "category": "Overseer"
      },
      {
        "command": "overseer.compactSession",
        "title": "Compact",
        "category": "Overseer"
      },
      {
        "command": "overseer.switchModel",
        "title": "Switch Model…",
        "category": "Overseer"
      },
      {
        "command": "overseer.clearSession",
        "title": "Clear Context",
        "category": "Overseer"
      },
      {
        "command": "overseer.costSession",
        "title": "Show Cost",
        "category": "Overseer"
      },
      {
        "command": "overseer.openLink",
        "title": "Open Link",
        "category": "Overseer",
        "icon": "$(link-external)"
      },
      {
        "command": "overseer.copyLink",
        "title": "Copy Link",
        "category": "Overseer"
      },
      {
        "command": "overseer.refreshLinks",
        "title": "Refresh Links",
        "category": "Overseer",
        "icon": "$(sync)"
      },
      {
        "command": "overseer.summarizeSession",
        "title": "Summarize with Haiku",
        "category": "Overseer",
        "icon": "$(sparkle)"
      },
      {
        "command": "overseer.toggleGithubLinks",
        "title": "Toggle GitHub PR Links",
        "category": "Overseer"
      },
      {
        "command": "overseer.toggleJiraLinks",
        "title": "Toggle Jira Ticket Links",
        "category": "Overseer"
      },
      {
        "command": "overseer.toggleArtifactLinks",
        "title": "Toggle Artifact Links",
        "category": "Overseer"
      },
      {
        "command": "overseer.pinLink",
        "title": "Pin Link",
        "category": "Overseer",
        "icon": "$(pin)"
      },
      {
        "command": "overseer.unpinLink",
        "title": "Unpin Link",
        "category": "Overseer",
        "icon": "$(pinned)"
      },
      {
        "command": "overseer.removeLink",
        "title": "Remove Link",
        "category": "Overseer",
        "icon": "$(close)"
      },
      {
        "command": "overseer.restoreLink",
        "title": "Restore Link",
        "category": "Overseer",
        "icon": "$(discard)"
      },
      {
        "command": "overseer.toggleRemovedLinks",
        "title": "Toggle Removed Links",
        "category": "Overseer"
      },
      {
        "command": "overseer.toggleLinkBrowser",
        "title": "Toggle Link Browser (External / VS Code)",
        "category": "Overseer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "overseer.newSession",
          "when": "view == overseer.sessions",
          "group": "navigation@0"
        },
        {
          "command": "overseer.allSessions",
          "when": "view == overseer.sessions",
          "group": "navigation@1"
        },
        {
          "command": "overseer.newGroup",
          "when": "view == overseer.sessions",
          "group": "navigation@2"
        },
        {
          "command": "overseer.refreshIndex",
          "when": "view == overseer.sessions",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "overseer.resumeSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\.(suspended|elsewhere)$/",
          "group": "inline@1"
        },
        {
          "command": "overseer.resumeSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\.(suspended|elsewhere)$/",
          "group": "1_session@1"
        },
        {
          "command": "overseer.unpinSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\./",
          "group": "9_remove@1"
        },
        {
          "command": "overseer.killSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\./",
          "group": "9_remove@2"
        },
        {
          "command": "overseer.renameGroup",
          "when": "view == overseer.sessions && viewItem =~ /^group\\.(user|auto)$/",
          "group": "1_group@1"
        },
        {
          "command": "overseer.deleteGroup",
          "when": "view == overseer.sessions && viewItem == group.user",
          "group": "9_remove@1"
        },
        {
          "command": "overseer.suspendSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\.(running|working)$/",
          "group": "inline@1"
        },
        {
          "command": "overseer.suspendSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\.(running|working)$/",
          "group": "1_session@2"
        },
        {
          "command": "overseer.renameSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\./",
          "group": "1_session@3"
        },
        {
          "command": "overseer.newSession",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "inline@0"
        },
        {
          "command": "overseer.addExistingToGroup",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "inline@1"
        },
        {
          "command": "overseer.addExistingToGroup",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "1_group@0"
        },
        {
          "command": "overseer.newSession",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "1_group@0"
        },
        {
          "command": "overseer.suspendGroup",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "1_group@2"
        },
        {
          "command": "overseer.compactSession",
          "when": "view == overseer.sessions && viewItem == session.running",
          "group": "2_claude@1"
        },
        {
          "command": "overseer.switchModel",
          "when": "view == overseer.sessions && viewItem == session.running",
          "group": "2_claude@2"
        },
        {
          "command": "overseer.clearSession",
          "when": "view == overseer.sessions && viewItem == session.running",
          "group": "2_claude@3"
        },
        {
          "command": "overseer.costSession",
          "when": "view == overseer.sessions && viewItem == session.running",
          "group": "2_claude@4"
        },
        {
          "command": "overseer.pinLink",
          "when": "view == overseer.sessions && viewItem =~ /^link\\.[a-z]+\\.unmarked$/",
          "group": "inline@0"
        },
        {
          "command": "overseer.unpinLink",
          "when": "view == overseer.sessions && viewItem =~ /^link\\.[a-z]+\\.pinned$/",
          "group": "inline@0"
        },
        {
          "command": "overseer.removeLink",
          "when": "view == overseer.sessions && viewItem =~ /^link\\.[a-z]+\\.(unmarked|pinned)$/",
          "group": "inline@2"
        },
        {
          "command": "overseer.restoreLink",
          "when": "view == overseer.sessions && viewItem =~ /^link\\.[a-z]+\\.removed$/",
          "group": "inline@2"
        },
        {
          "command": "overseer.pinLink",
          "when": "view == overseer.sessions && viewItem =~ /^link\\.[a-z]+\\.(unmarked|removed)$/",
          "group": "2_mark@1"
        },
        {
          "command": "overseer.unpinLink",
          "when": "view == overseer.sessions && viewItem =~ /^link\\.[a-z]+\\.pinned$/",
          "group": "2_mark@1"
        },
        {
          "command": "overseer.removeLink",
          "when": "view == overseer.sessions && viewItem =~ /^link\\.[a-z]+\\.(unmarked|pinned)$/",
          "group": "2_mark@2"
        },
        {
          "command": "overseer.restoreLink",
          "when": "view == overseer.sessions && viewItem =~ /^link\\.[a-z]+\\.removed$/",
          "group": "2_mark@2"
        },
        {
          "command": "overseer.openLink",
          "when": "view == overseer.sessions && viewItem =~ /^link\\./",
          "group": "inline@1"
        },
        {
          "command": "overseer.openLink",
          "when": "view == overseer.sessions && viewItem =~ /^link\\./",
          "group": "1_link@1"
        },
        {
          "command": "overseer.copyLink",
          "when": "view == overseer.sessions && viewItem =~ /^link\\./",
          "group": "1_link@2"
        },
        {
          "command": "overseer.refreshLinks",
          "when": "view == overseer.sessions && viewItem =~ /^session\\./",
          "group": "3_links@1"
        },
        {
          "command": "overseer.summarizeSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\./",
          "group": "3_links@2"
        }
      ],
      "commandPalette": [
        {
          "command": "overseer.pinLink",
          "when": "false"
        },
        {
          "command": "overseer.unpinLink",
          "when": "false"
        },
        {
          "command": "overseer.removeLink",
          "when": "false"
        },
        {
          "command": "overseer.restoreLink",
          "when": "false"
        },
        {
          "command": "overseer.resumeSession",
          "when": "false"
        },
        {
          "command": "overseer.focusSession",
          "when": "false"
        },
        {
          "command": "overseer.unpinSession",
          "when": "false"
        },
        {
          "command": "overseer.killSession",
          "when": "false"
        },
        {
          "command": "overseer.addExistingToGroup",
          "when": "false"
        },
        {
          "command": "overseer.renameGroup",
          "when": "false"
        },
        {
          "command": "overseer.deleteGroup",
          "when": "false"
        },
        {
          "command": "overseer.rename",
          "when": "false"
        },
        {
          "command": "overseer.suspendSession",
          "when": "false"
        },
        {
          "command": "overseer.suspendGroup",
          "when": "false"
        },
        {
          "command": "overseer.renameSession",
          "when": "false"
        },
        {
          "command": "overseer.clickSession",
          "when": "false"
        },
        {
          "command": "overseer.compactSession",
          "when": "false"
        },
        {
          "command": "overseer.switchModel",
          "when": "false"
        },
        {
          "command": "overseer.clearSession",
          "when": "false"
        },
        {
          "command": "overseer.costSession",
          "when": "false"
        },
        {
          "command": "overseer.openLink",
          "when": "false"
        },
        {
          "command": "overseer.copyLink",
          "when": "false"
        },
        {
          "command": "overseer.refreshLinks",
          "when": "false"
        },
        {
          "command": "overseer.summarizeSession",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Overseer",
      "properties": {
        "overseer.claudeHome": {
          "type": "string",
          "default": "",
          "description": "Claude config directory. Empty means ~/.claude."
        },
        "overseer.links.github.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show GitHub pull requests under each session."
        },
        "overseer.links.jira.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show Jira tickets under each session."
        },
        "overseer.links.artifacts.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show claude.ai artifacts under each session."
        },
        "overseer.links.jira.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Jira site for tickets whose URL the transcript doesn't show, e.g. https://acme.atlassian.net."
        },
        "overseer.links.judgeModel": {
          "type": "string",
          "default": "haiku",
          "description": "Model that decides which links matter to a session. Runs headless through the claude CLI."
        },
        "overseer.links.showIrrelevant": {
          "type": "boolean",
          "default": false,
          "description": "Also show links the judge marked irrelevant, dimmed."
        },
        "overseer.links.showRemoved": {
          "type": "boolean",
          "default": false,
          "description": "Also show links you removed, dimmed, so you can restore them."
        },
        "overseer.links.liveStatus": {
          "type": "boolean",
          "default": true,
          "description": "Show live PR state through gh and Jira status through acli. Checked every five minutes for expanded sessions."
        },
        "overseer.links.openIn": {
          "type": "string",
          "enum": ["external", "vscode"],
          "enumDescriptions": ["Your default browser.", "The browser built into VS Code."],
          "default": "external",
          "description": "Where clicked links open."
        },
        "overseer.summary.model": {
          "type": "string",
          "default": "haiku",
          "description": "Model for Summarize with Haiku. Runs only when you click it."
        }
      }
    },
    "keybindings": [
      {
        "command": "overseer.rename",
        "key": "f2",
        "when": "focusedView == overseer.sessions"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
