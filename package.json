{
  "name": "djaunt-overseer",
  "displayName": "Overseer",
  "description": "Vertical tabs for Claude CLI sessions: group by ticket, suspend, and resume from any repo.",
  "version": "0.0.1",
  "publisher": "djaunt",
  "private": true,
  "license": "UNLICENSED",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/tory37/djaunt-overseer"
  },
  "homepage": "https://tory37.github.io/djaunt-overseer/",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "djauntOverseer",
          "title": "Overseer",
          "icon": "media/overseer.svg"
        }
      ]
    },
    "views": {
      "djauntOverseer": [
        {
          "id": "overseer.sessions",
          "name": "Sessions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "overseer.sessions",
        "contents": "No pinned sessions yet.\n[Browse all sessions](command:overseer.allSessions)"
      }
    ],
    "commands": [
      {
        "command": "overseer.allSessions",
        "title": "All Sessions…",
        "category": "Overseer",
        "icon": "$(search)"
      },
      {
        "command": "overseer.refreshIndex",
        "title": "Refresh Session Index",
        "category": "Overseer",
        "icon": "$(refresh)"
      },
      {
        "command": "overseer.newGroup",
        "title": "New Group…",
        "category": "Overseer",
        "icon": "$(new-folder)"
      },
      {
        "command": "overseer.resumeSession",
        "title": "Resume",
        "category": "Overseer",
        "icon": "$(play)"
      },
      {
        "command": "overseer.focusSession",
        "title": "Focus Session",
        "category": "Overseer"
      },
      {
        "command": "overseer.addExistingToGroup",
        "title": "Add Existing Session…",
        "category": "Overseer",
        "icon": "$(search)"
      },
      {
        "command": "overseer.killSession",
        "title": "Kill and Remove",
        "category": "Overseer",
        "icon": "$(trash)"
      },
      {
        "command": "overseer.unpinSession",
        "title": "Remove from Sidebar",
        "category": "Overseer",
        "icon": "$(close)"
      },
      {
        "command": "overseer.renameGroup",
        "title": "Rename Group…",
        "category": "Overseer"
      },
      {
        "command": "overseer.deleteGroup",
        "title": "Delete Group",
        "category": "Overseer"
      },
      {
        "command": "overseer.rename",
        "title": "Rename",
        "category": "Overseer"
      },
      {
        "command": "overseer.newSession",
        "title": "New Session…",
        "category": "Overseer",
        "icon": "$(add)"
      },
      {
        "command": "overseer.suspendSession",
        "title": "Suspend",
        "category": "Overseer",
        "icon": "$(debug-pause)"
      },
      {
        "command": "overseer.suspendGroup",
        "title": "Suspend All in Group",
        "category": "Overseer",
        "icon": "$(debug-pause)"
      },
      {
        "command": "overseer.renameSession",
        "title": "Rename Session…",
        "category": "Overseer"
      },
      {
        "command": "overseer.clickSession",
        "title": "Open Session",
        "category": "Overseer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "overseer.newSession",
          "when": "view == overseer.sessions",
          "group": "navigation@0"
        },
        {
          "command": "overseer.allSessions",
          "when": "view == overseer.sessions",
          "group": "navigation@1"
        },
        {
          "command": "overseer.newGroup",
          "when": "view == overseer.sessions",
          "group": "navigation@2"
        },
        {
          "command": "overseer.refreshIndex",
          "when": "view == overseer.sessions",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "overseer.resumeSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\.(suspended|elsewhere)$/",
          "group": "inline@1"
        },
        {
          "command": "overseer.resumeSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\.(suspended|elsewhere)$/",
          "group": "1_session@1"
        },
        {
          "command": "overseer.unpinSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\./",
          "group": "9_remove@1"
        },
        {
          "command": "overseer.killSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\./",
          "group": "9_remove@2"
        },
        {
          "command": "overseer.renameGroup",
          "when": "view == overseer.sessions && viewItem =~ /^group\\.(user|auto)$/",
          "group": "1_group@1"
        },
        {
          "command": "overseer.deleteGroup",
          "when": "view == overseer.sessions && viewItem == group.user",
          "group": "9_remove@1"
        },
        {
          "command": "overseer.suspendSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\.(running|working)$/",
          "group": "inline@1"
        },
        {
          "command": "overseer.suspendSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\.(running|working)$/",
          "group": "1_session@2"
        },
        {
          "command": "overseer.renameSession",
          "when": "view == overseer.sessions && viewItem =~ /^session\\./",
          "group": "1_session@3"
        },
        {
          "command": "overseer.newSession",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "inline@0"
        },
        {
          "command": "overseer.addExistingToGroup",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "inline@1"
        },
        {
          "command": "overseer.addExistingToGroup",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "1_group@0"
        },
        {
          "command": "overseer.newSession",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "1_group@0"
        },
        {
          "command": "overseer.suspendGroup",
          "when": "view == overseer.sessions && viewItem =~ /^group\\./",
          "group": "1_group@2"
        }
      ],
      "commandPalette": [
        {
          "command": "overseer.resumeSession",
          "when": "false"
        },
        {
          "command": "overseer.focusSession",
          "when": "false"
        },
        {
          "command": "overseer.unpinSession",
          "when": "false"
        },
        {
          "command": "overseer.killSession",
          "when": "false"
        },
        {
          "command": "overseer.addExistingToGroup",
          "when": "false"
        },
        {
          "command": "overseer.renameGroup",
          "when": "false"
        },
        {
          "command": "overseer.deleteGroup",
          "when": "false"
        },
        {
          "command": "overseer.rename",
          "when": "false"
        },
        {
          "command": "overseer.suspendSession",
          "when": "false"
        },
        {
          "command": "overseer.suspendGroup",
          "when": "false"
        },
        {
          "command": "overseer.renameSession",
          "when": "false"
        },
        {
          "command": "overseer.clickSession",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Overseer",
      "properties": {
        "overseer.claudeHome": {
          "type": "string",
          "default": "",
          "description": "Claude config directory. Empty means ~/.claude."
        }
      }
    },
    "keybindings": [
      {
        "command": "overseer.rename",
        "key": "f2",
        "when": "focusedView == overseer.sessions"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && vsce package --no-dependencies --skip-license"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
